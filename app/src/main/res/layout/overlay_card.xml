<?xml version="1.0" encoding="utf-8"?>
<!-- M1 悬浮窗比价卡片：标题行（店名 + 关闭）+ 比价行容器 + 无数据占位。
     比价行由 OverlayService 按 Deal 列表动态填充到 overlay_deals_container。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="240dp"
    android:background="@drawable/overlay_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 标题行：店名 + 关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_store_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:text="×"
            android:textColor="#AAAAAA"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 比价行容器：每行 = 平台名 / 实付价 / 明细摘要，最低价钱行高亮 -->
    <LinearLayout
        android:id="@+id/overlay_deals_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- 无数据时的占位文案（兜底） -->
    <TextView
        android:id="@+id/overlay_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="进入店铺菜单页后自动比价"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
